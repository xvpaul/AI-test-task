// OpenClaw Gateway — ШАБЛОН конфигурации.
// Плейсхолдеры подставляются в CI из GitHub Secrets (см. CICD.md).
// Этот файл безопасен для коммита — секретов в нём нет.
//
// ВАЖНО: не пишите в комментариях литеральный плейсхолдер-синтаксис —
// шаг проверки в deploy.yml ищет неподставленные плейсхолдеры по всему файлу
// и упадёт на совпадении внутри комментария.
//
// Отрендеренный openclaw.config.json5 в git не попадает (.gitignore).

{
  gateway: {
    // Обязательно. Конфиг без mode шлюз считает повреждённым и отказывается
    // стартовать: "Missing config. Run `openclaw setup` or set gateway.mode=local".
    // Значение local — самостоятельный одиночный шлюз, наш случай.
    // Флаг --allow-unconfigured не подходит: он ничего не сохраняет,
    // и после каждого перезапуска ошибка возвращается.
    mode: "local",
  },

  session: {
    // Обязательно при dmPolicy: "open". Значение по умолчанию — "main",
    // и оно сводит ВСЕ личные переписки в одну общую сессию: посторонний,
    // написавший боту, попадает в контекст владельца и видит его историю.
    // per-channel-peer разводит сессии по паре «канал + отправитель».
    dmScope: "per-channel-peer",
  },

  // Ограничение инструментов. Проверено `openclaw security audit --deep`:
  // без этого блока агенту доступны exec/process, чтение и запись файлов,
  // browser и control-plane (gateway, cron) — при dmPolicy "open" это означало
  // выполнение команд на сервере по запросу любого собеседника.
  // Ассистенту в мессенджере ничего из этого не нужно.
  tools: {
    profile: "messaging",
    deny: [
      "group:runtime",
      "group:fs",
      "group:automation",
      "gateway",
      "cron",
      // Выход в сеть. Ассистенту в мессенджере не нужен, а при открытой личке
      // это канал наружу: инъекция в диалоге превращается в запрос на чужой
      // адрес вместе с данными. Все три вместе — по отдельности бессмысленно,
      // закрытый браузер обходится прямой выборкой страницы.
      "browser",
      "web_fetch",
      "web_search",
      // Порождение сессий и отправка в чужие: в обход session.dmScope
      // это дало бы доступ к контексту другого собеседника.
      "sessions_spawn",
      "sessions_send",
    ],
    // Даже если что-то из файловых инструментов вернётся — не дальше workspace.
    // Иначе в досягаемости оказывается ~/.openclaw с ключом и токеном бота.
    fs: { workspaceOnly: true },
    elevated: { enabled: false },
  },

  models: {
    providers: {
      // Google AI Studio через OpenAI-совместимый эндпоинт.
      // Namespace "aistudio" — чтобы не столкнуться со встроенными провайдерами.
      aistudio: {
        baseUrl: "https://generativelanguage.googleapis.com/v1beta/openai/",
        apiKey: "${GEMINI_API_KEY}",

        // Схема требует ключ name (строка). Пример из документации содержал
        // ключ-псевдоним, которого схема не знает, — проверено сообщением
        // валидатора шлюза. В комментариях имена отвергнутых ключей не пишем:
        // при отладке их легко спутать с реальным содержимым конфига.
        models: [
          {
            id: "gemini-3.7-flash",
            name: "gemini-3.7-flash",
            contextTokens: 1000000,
          },
          {
            // Запасная модель на случай исчерпания суточной квоты.
            id: "gemini-3.5-flash-lite",
            name: "gemini-3.5-flash-lite",
            contextTokens: 1000000,
          },
        ],
      },
    },
  },

  agents: {
    defaults: {
      // Каталог bootstrap-файлов персоны. SOUL.md кладётся именно сюда, а не
      // в корень ~/.openclaw — там он просто лежит и не читается.
      // Системный промпт собирается из SOUL.md, затем IDENTITY.md, USER.md,
      // AGENTS.md, MEMORY.md. Путь — внутри контейнера, не на хосте.
      workspace: "/home/node/.openclaw/workspace",

      model: {
        // Основная — flash-lite: на бесплатном тире именно она стабильно
        // отвечает 200. У gemini-3.7-flash наблюдались постоянные 503
        // ("experiencing high demand"), из-за чего каждое сообщение
        // ждало три неудачные попытки (4–25 с) перед переключением.
        primary: "aistudio/gemini-3.5-flash-lite",
        // Более сильная модель остаётся запасной: если её разгрузят,
        // ответы станут качественнее без правки конфига.
        fallbacks: ["aistudio/gemini-3.7-flash"],
      },
    },
  },

  channels: {
    telegram: {
      enabled: true,
      botToken: "${TELEGRAM_BOT_TOKEN}",

      // Режим доступа к личке. Переключается переменной репозитория,
      // без правки этого файла (см. CICD.md, шаг 2).
      dmPolicy: "${TELEGRAM_DM_POLICY}",

      // Состав списка вычисляется в CI по значению dmPolicy и подставляется
      // целиком, вместе с кавычками. Держать здесь один лишь numeric ID нельзя:
      // режим open проходит валидацию только со звёздочкой в списке, и попытка
      // переключить режим одной переменной давала невалидную пару
      // "open + конкретный ID".
      allowFrom: [${TELEGRAM_ALLOW_FROM}],

      groups: {
        "*": { requireMention: true },
      },
    },
  },
}
